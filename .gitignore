# ============ Python 编译产物（每次导入都会重新生成）============
__pycache__/
*.py[cod]

# ============ 虚拟环境（每人本机一套，不该共享）============
.venv/
venv/
env/

# ============ IDE 配置（各人不同，共享只会互相覆盖）============
.idea/
.vscode/

# ============ 可再生的中间产物 ============
# 向量库：由 jobs_clean.json 重新生成即可，且体积会越来越大
chroma_db/
# 抓取的原始 HTML 快照：fetch.py 随时能重新抓一份
data/raw/

# ============ 凭据（一旦提交进 git 历史，很难彻底抹掉）============
.env
*.env
!.env.example

# ============ 系统垃圾 ============
*.log
Thumbs.db
.DS_Store
